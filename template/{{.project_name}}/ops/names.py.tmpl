"""Print the deployed names of this target's schemas, for the laptop tasks in mise.toml.

The bundle decides the names (a target may prefix them); the laptop reads them back from
`databricks bundle summary`, so a run from here lands where the job lands.
"""

import json
import os
import shlex
import subprocess
import sys

target = os.environ.get("TARGET", "dev")
try:
    summary = subprocess.run(
        ["databricks", "bundle", "summary", "-t", target, "-o", "json"],
        capture_output=True,
        text=True,
        check=False,
    )
except FileNotFoundError:
    sys.exit("The Databricks CLI is not on the PATH: `mise install` brings it.")
if summary.returncode != 0:
    sys.stderr.write(summary.stderr)
    sys.exit("No deployed names to read: deploy the target first (mise run deploy).")
schemas = json.loads(summary.stdout)["resources"]["schemas"]
for variable, key in (
    ("RAW", "raw"),
    ("RAW_STAGING", "raw_staging"),
{{- if eq .include_dbt "yes" }}
    ("SILVER", "silver"),
{{- end }}
):
    print(f"export {variable}={shlex.quote(schemas[key]['name'])}")
