# The gate on every change: what `mise run check` runs, and the example pipeline into a
# local database. No workspace needed.
name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
{%- if include_contracts %}
          fetch-depth: 0 # the base branch too: the contracts are compared with it
{%- endif %}
      - uses: jdx/mise-action@v3
      - run: uv sync --locked
      - run: mise run check
{%- if include_contracts %}
      # A contract that is out is a promise. An edit that breaks it fails here: a breaking
      # change is a new version file. A new file always passes.
      - name: No breaking change to a published contract
        if: github.event_name == 'pull_request'
        run: uv run ops/ports.py breaking --base "origin/$GITHUB_BASE_REF"
{%- endif %}
      - run: mise run dev
